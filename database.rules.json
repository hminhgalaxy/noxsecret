{
  "rules": {
    ".read": false,
    ".write": false,
    "nox_data": {
      ".read": true,
      "$cat": {
        ".write": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'hminhgalaxy@gmail.com'",
        "$id": {
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200"
          },
          "desc": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 2000"
          },
          "url": {
            ".validate": "newData.isString() && newData.val().length <= 2048 && newData.val().matches(/^https?:\\/\\/.+/)"
          },
          "img": {
            ".validate": "newData.isString() && newData.val().length <= 2048 && newData.val().matches(/^https?:\\/\\/.+/)"
          },
          "code": {
            ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 200000"
          },
          "vault": {
            ".validate": "newData.isBoolean()"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "copies": {
            ".write": "newData.isNumber() && data.exists() && newData.val() === data.val() + 1",
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "nox_categories": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'hminhgalaxy@gmail.com'",
      "$k": {
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
        },
        "node": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]+$/) && newData.val().length <= 32"
        },
        "sub": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 120"
        },
        "icon": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 24"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 32"
        }
      }
    },
    "nox_maintenance": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'hminhgalaxy@gmail.com'"
    },
    "nox_notice": {
      ".read": true,
      ".write": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'hminhgalaxy@gmail.com'",
      "title": {
        ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 120"
      },
      "body": {
        ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 2000"
      },
      "enabled": {
        ".validate": "newData.isBoolean()"
      }
    },
    "nox_theme": {
      "bgType": {
        ".read": true,
        ".write": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'hminhgalaxy@gmail.com'",
        ".validate": "newData.isString() && (newData.val() === 'image' || newData.val() === 'video' || newData.val() === 'none')"
      },
      "bgData": {
        ".read": true,
        ".write": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'hminhgalaxy@gmail.com'",
        ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 9437184"
      },
      "audioData": {
        ".read": true,
        ".write": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'hminhgalaxy@gmail.com'",
        ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 9437184"
      },
      "audioName": {
        ".read": true,
        ".write": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'hminhgalaxy@gmail.com'",
        ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 200"
      },
      "updatedAt": {
        ".read": true,
        ".write": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'hminhgalaxy@gmail.com'"
      },
      "api": {
        ".read": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'hminhgalaxy@gmail.com'",
        ".write": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'hminhgalaxy@gmail.com'"
      }
    },
    "nox_users": {
      ".read": "auth != null && auth.token.email_verified === true && auth.token.email.toLowerCase() === 'hminhgalaxy@gmail.com'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "email": {
          ".validate": "newData.isString() && newData.val() === auth.token.email"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 200"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 1000"
        },
        "provider": {
          ".validate": "newData.isString() && newData.val().length >= 0 && newData.val().length <= 60"
        },
        "lastLogin": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "!data.exists() && newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}