{
  "rules": {
    ".read": false,
    ".write": false,
    "nox_data": {
      "scripts": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "apks": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "ios": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "links": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "notifications": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "notification": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "announcements": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "announcement": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "notice": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "thongbao": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "stars": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "music": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "settings": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "lists": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true"
      },
      "reports": {
        ".read": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true",
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true",
        "$id": {
          ".write": "auth != null && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'new' && newData.child('createdAt').val() === now && newData.parent().parent().child('rate/reports/' + auth.uid).val() === now",
          ".validate": "$id.matches(/^R-[A-Z0-9]{4,14}$/) && newData.hasChildren(['code','kind','type','status','uid','createdAt']) && newData.child('code').val() === $id",
          "code": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "kind": {
            ".validate": "newData.isString() && newData.val().matches(/^(script|apk|ios|link|other)$/)"
          },
          "type": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
          },
          "target": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "targetKey": {
            ".validate": "newData.isString() && newData.val().length <= 100"
          },
          "node": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "desc": {
            ".validate": "newData.isString() && newData.val().length <= 600"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(new|processing|resolved|rejected)$/)"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "handledAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "suggestions": {
        ".read": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true",
        ".write": "auth != null && auth.token.email == 'hminhgalaxy@gmail.com' && auth.token.email_verified == true",
        "$id": {
          ".write": "auth != null && !data.exists() && newData.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'pending' && newData.child('createdAt').val() === now && newData.parent().parent().child('rate/suggestions/' + auth.uid).val() === now",
          ".validate": "$id.matches(/^s_[a-z0-9]{6,16}$/) && newData.hasChildren(['kind','name','status','uid','createdAt'])",
          "kind": {
            ".validate": "newData.isString() && newData.val().matches(/^(script|apk|ios|link|other)$/)"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
          },
          "url": {
            ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val().beginsWith('http://') || newData.val().beginsWith('https://') || newData.val().beginsWith('itms-services://'))"
          },
          "download": {
            ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val().beginsWith('http://') || newData.val().beginsWith('https://') || newData.val().beginsWith('itms-services://'))"
          },
          "code": {
            ".validate": "newData.isString() && newData.val().length <= 20000"
          },
          "desc": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "version": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "size": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "status": {
            ".validate": "newData.isString() && newData.val().matches(/^(pending|approved|rejected)$/)"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "reviewedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "rate": {
        "reports": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() === now && (!data.exists() || now > data.val() + 30000)"
          }
        },
        "suggestions": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber() && newData.val() === now && (!data.exists() || now > data.val() + 30000)"
          }
        }
      }
    }
  }
}
